<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 🔴 Added with the remote-STT client. The app had never made a network
         call before this change, so INTERNET was genuinely absent — and its
         absence raises no permission dialog and no build warning: every
         socket simply throws at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- icon/roundIcon point at the adaptive icon in mipmap-anydpi-v26, NOT at a
         bare drawable: a 24dp vector used directly as a launcher icon is drawn
         unmasked and unpadded, so it rendered small and got square-cropped by
         the launcher's own icon shapes. roundIcon exists because some launchers
         (Samsung's included — the target device is a Galaxy S21) still query it,
         and one that asks and finds nothing drops to the legacy square path. -->
    <!-- networkSecurityConfig rather than usesCleartextTraffic="true": the
         transcription service speaks plain HTTP on the Nebula mesh, and the
         XML permits cleartext for THAT ONE HOST while leaving it refused
         everywhere else. The blanket attribute would permit an unencrypted
         request to any host on any network, which is a real downgrade — see
         res/xml/network_security_config.xml for the full reasoning. -->
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Dicta">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating dictation overlay: dialog-themed, excluded from recents. -->
        <activity
            android:name=".DictateActivity"
            android:exported="false"
            android:theme="@style/Theme.Dicta.Overlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Transcription settings: the base URL and the bearer token. Not
             exported — the token field must not be reachable by another app's
             intent. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- Quick Settings tile: the "trigger from anywhere" entry point. -->
        <service
            android:name=".DictaTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Floating bubble host. specialUse: user-toggled overlay widget. -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-toggled floating mic bubble that opens voice dictation from anywhere on the device." />
        </service>

        <!--
          MediaProjection host. On Android 14+ a mediaProjection-typed FGS must
          already be running before MediaProjectionManager.getMediaProjection()
          is called, so the consent result is handed to this service rather than
          used in the Activity.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Serves the captured PNG to the share target. Hand-rolled rather than
          androidx.core FileProvider so the APK keeps zero runtime
          dependencies — see DictaFileProvider's kdoc. grantUriPermissions is
          what makes FLAG_GRANT_READ_URI_PERMISSION on the share intent
          meaningful; without it the receiver gets a SecurityException.
        -->
        <provider
            android:name=".DictaFileProvider"
            android:authorities="dev.zacx.dicta.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
