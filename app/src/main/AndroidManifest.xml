<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_mic"
        android:label="@string/app_name"
        android:theme="@style/Theme.Dicta">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Floating dictation overlay: dialog-themed, excluded from recents. -->
        <activity
            android:name=".DictateActivity"
            android:exported="false"
            android:theme="@style/Theme.Dicta.Overlay"
            android:excludeFromRecents="true"
            android:launchMode="singleTop" />

        <!-- Quick Settings tile: the "trigger from anywhere" entry point. -->
        <service
            android:name=".DictaTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!-- Floating bubble host. specialUse: user-toggled overlay widget. -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-toggled floating mic bubble that opens voice dictation from anywhere on the device." />
        </service>

        <!--
          MediaProjection host. On Android 14+ a mediaProjection-typed FGS must
          already be running before MediaProjectionManager.getMediaProjection()
          is called, so the consent result is handed to this service rather than
          used in the Activity.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Serves the captured PNG to the share target. Hand-rolled rather than
          androidx.core FileProvider so the APK keeps zero runtime
          dependencies — see DictaFileProvider's kdoc. grantUriPermissions is
          what makes FLAG_GRANT_READ_URI_PERMISSION on the share intent
          meaningful; without it the receiver gets a SecurityException.
        -->
        <provider
            android:name=".DictaFileProvider"
            android:authorities="dev.zacx.dicta.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
