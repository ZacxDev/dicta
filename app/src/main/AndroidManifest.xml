<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 🔴 Added with the remote-STT client. The app had never made a network
         call before this change, so INTERNET was genuinely absent — and its
         absence raises no permission dialog and no build warning: every
         socket simply throws at runtime. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 🔴 BubbleService records inline (tap the bubble, speak, tap again), so on
         targetSdk 34 it must hold this as well as declare the microphone FGS
         type. Neither omission is a build error; the service simply throws out
         of startForeground the first time the user taps the bubble. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 🔴 Without this the BOOT_COMPLETED receiver below is simply never
         invoked: the broadcast is not delivered, no exception is raised and no
         build warning appears, so the only symptom is a bubble that quietly
         fails to come back after a reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- icon/roundIcon point at the adaptive icon in mipmap-anydpi-v26, NOT at a
         bare drawable: a 24dp vector used directly as a launcher icon is drawn
         unmasked and unpadded, so it rendered small and got square-cropped by
         the launcher's own icon shapes. roundIcon exists because some launchers
         (Samsung's included — the target device is a Galaxy S21) still query it,
         and one that asks and finds nothing drops to the legacy square path. -->
    <!-- networkSecurityConfig rather than usesCleartextTraffic="true": the
         transcription service speaks plain HTTP on the Nebula mesh, and the
         XML permits cleartext for THAT ONE HOST while leaving it refused
         everywhere else. The blanket attribute would permit an unencrypted
         request to any host on any network, which is a real downgrade — see
         res/xml/network_security_config.xml for the full reasoning. -->
    <!-- 🔴 allowBackup is FALSE deliberately, and the platform default is true.
         The dictation history store lands in noBackupFilesDir, so with the
         default in place up to 2 GiB of the user's recorded VOICE plus every
         transcript would be eligible for cloud auto-backup and for
         `adb backup` — a data-egress change with no lint error, no build
         warning and no runtime symptom. Nothing would ever go red.

         One attribute rather than android:dataExtractionRules, on DRIFT
         grounds and not capability. dataExtractionRules is API 31+ and needs
         two rule sets (<cloud-backup> and <device-transfer>), and minSdk here
         is 26, so devices on 26–30 would additionally need fullBackupContent:
         three files that must agree with each other AND with the store's
         directory name. That is exactly the cross-file drift class that
         produced issue #11. The single attribute covers both transports,
         every API level, and shared_prefs too.

         Accepted cost, so it is not rediscovered as a bug: on device
         migration the user loses backup of their base URL and language
         preference (two fields, under a minute to re-enter). The bearer token
         has to be re-entered regardless — the AndroidKeyStore key wrapping it
         is non-exportable, so it could never have been restored anyway.

         Pinned by BackupManifestTest, which also fails if the rule-file
         attributes appear. -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Dicta">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Floating dictation overlay: dialog-themed, excluded from recents.

          🔴 taskAffinity is LOAD-BEARING, not tidiness. The three "from
          anywhere" entry points (bubble, tile, notification) start this
          activity with FLAG_ACTIVITY_NEW_TASK, and that flag does NOT mean
          "make a new task" — it means "use the task matching this activity's
          taskAffinity, creating one only if none exists". With no affinity
          declared this activity inherited the application default, which is
          MainActivity's task: tapping the bubble brought Dicta's own task
          forward and stacked the overlay on top of MainActivity, so the
          translucent card rendered over the entire app UI instead of over
          whatever the user was actually looking at. That was issue #11.

          The value must stay in sync with DictateLaunch.OVERLAY_TASK_AFFINITY;
          DictateLaunchTest pins the two together, because they live in
          different files and a drift here silently restores the bug.

          A distinct name rather than "": an empty affinity means "no affinity
          to anything" and can hand out a fresh task per launch, which fights
          launchMode="singleTop".
        -->
        <activity
            android:name=".DictateActivity"
            android:exported="false"
            android:theme="@style/Theme.Dicta.Overlay"
            android:excludeFromRecents="true"
            android:taskAffinity="dev.zacx.dicta.overlay"
            android:launchMode="singleTop" />

        <!-- Transcription settings: the base URL and the bearer token. Not
             exported — the token field must not be reachable by another app's
             intent. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- Quick Settings tile: the "trigger from anywhere" entry point. -->
        <service
            android:name=".DictaTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile_mic"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

        <!--
          Floating bubble host, and — since the inline-dictation redesign — the
          owner of the microphone session.

          🔴 BOTH types are declared, and the service promotes to the SPECIFIC
          one at runtime: microphone while recording, specialUse at rest. The
          obvious edit (replace specialUse with microphone) is wrong and is
          pinned against by MicrophoneFgsManifestTest. Android 14 throws
          SecurityException out of startForeground when a microphone-typed FGS
          is promoted without RECORD_AUDIO, and this service MUST keep running
          when the microphone is denied: that is exactly the state in which a
          tap falls back to opening DictateActivity, which is the only place an
          app can call requestPermissions from and the only place the
          mic-denied fallback copy lives. A microphone-only type would kill the
          bubble for precisely the users who have not granted the mic.

          specialUse also remains the type the PROPERTY below describes.
        -->
        <service
            android:name=".BubbleService"
            android:exported="false"
            android:foregroundServiceType="microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-toggled floating mic bubble that opens voice dictation from anywhere on the device." />
        </service>

        <!--
          MediaProjection host. On Android 14+ a mediaProjection-typed FGS must
          already be running before MediaProjectionManager.getMediaProjection()
          is called, so the consent result is handed to this service rather than
          used in the Activity.
        -->
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!--
          Restores the bubble after a reboot when the user had it on.

          exported="true" is deliberate and is the documented requirement for a
          manifest receiver that listens for a system broadcast on Android 12+;
          BOOT_COMPLETED is a protected action, so only the system can send it.
          The receiver additionally checks the action itself, because a receiver
          is reachable by an explicit intent whatever its filter says.

          🔴 The service it starts is specialUse AT REST — BubbleService only
          promotes to microphone while recording. That distinction is what makes
          this start legal: a microphone-typed FGS launched from a
          BOOT_COMPLETED receiver is refused from Android 14 on, and the wider
          Android 15 list of disallowed types (dataSync, camera, mediaPlayback,
          phoneCall, mediaProjection, microphone) still does not include
          specialUse. See BubbleBootReceiver's kdoc for the whole measurement.
        -->
        <receiver
            android:name=".BubbleBootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          Serves the captured PNG to the share target. Hand-rolled rather than
          androidx.core FileProvider so the APK keeps zero runtime
          dependencies — see DictaFileProvider's kdoc. grantUriPermissions is
          what makes FLAG_GRANT_READ_URI_PERMISSION on the share intent
          meaningful; without it the receiver gets a SecurityException.
        -->
        <provider
            android:name=".DictaFileProvider"
            android:authorities="dev.zacx.dicta.files"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
