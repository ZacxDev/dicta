<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating dictation card: elevation level 2 of the surface ramp
  (@color/dicta_surface_2) plus a 1dp hairline.

  The hairline is @color/dicta_divider, NOT @color/dicta_outline: it separates
  the card from the dimmed app behind it, which is decoration — the dim already
  does the real separating. A 3:1 boundary here would read as a frame.

  Radius 24dp (was 20dp) so the card reads as the same family as the 28dp mic
  pill and the 16dp field; the ScrollView that draws this sets
  clipToOutline="true" so the scrolling content is clipped to these corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dicta_surface_2" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/dicta_divider" />
</shape>
