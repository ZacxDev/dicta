<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating overlay's WINDOW background.

  This is not cosmetic: on Android a dialog's screen margin is *decor padding
  derived from the window background drawable*, not a layout margin.
  PhoneWindow.generateLayout() hands this drawable to DecorView.setWindowBackground(),
  and View.setBackgroundDrawable() copies Drawable.getPadding() into the view's
  padding. The platform's own dialog background
  (@android:drawable/dialog_background_material) is an <inset> with 16dp on all
  four sides — that inset IS the dialog margin.

  The previous theme overrode windowBackground with @android:color/transparent.
  A ColorDrawable returns false from getPadding(), so the decor padding became 0
  and the card had no inset left at all. Keeping an <inset> here restores the
  margin by the same mechanism the platform uses, independent of what the
  content layout does.

  The inner shape is transparent because the visible card is drawn by the
  content's own @drawable/card_bg.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/overlay_window_inset"
    android:insetTop="@dimen/overlay_window_inset"
    android:insetRight="@dimen/overlay_window_inset"
    android:insetBottom="@dimen/overlay_window_inset">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/transparent" />
    </shape>
</inset>
