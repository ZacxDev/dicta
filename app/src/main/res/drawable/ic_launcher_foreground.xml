<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon FOREGROUND layer. 108x108dp canvas, of which only the central
  72dp is guaranteed visible and only the central 66dp is safe from every mask
  shape. Everything drawable therefore lives inside a radius of 33 from
  (54,54).

  The path data is the SAME glyph as ic_mic.xml, reused verbatim rather than
  redrawn, so the launcher icon and the in-app/bubble mic cannot drift apart.
  It is authored against a 24x24 viewport, so it is placed by a <group>
  transform instead of being rescaled by hand — hand-rescaled path data is
  unreviewable and silently wrong.

  Placement arithmetic (why these exact numbers):
    glyph bounds in the 24x24 source : x 5..21, y 2..21  -> 16 wide, 19 tall
    glyph centre                     : (13, 11.5)
    scale 2.45                       : 39.2 wide, 46.6 tall
    scaled centre                    : (31.85, 28.18)
    translate to centre on (54,54)   : (54-31.85, 54-28.18) = (22.15, 25.83)
    resulting bounds                 : x 34.4..73.6, y 30.7..77.3
    worst-case corner from centre    : hypot(19.6, 23.3) = 30.4  <  33  ✓

  🔴 The bound that matters is the DIAGONAL distance, not width and height
  separately. A glyph whose box fits inside 66dp can still have a corner
  outside the safe CIRCLE, which is what a circular mask actually clips.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="2.45"
        android:scaleY="2.45"
        android:translateX="22.15"
        android:translateY="25.83">
        <path
            android:fillColor="@color/ic_launcher_mic"
            android:pathData="M12,14c1.66,0 3,-1.34 3,-3L15,5c0,-1.66 -1.34,-3 -3,-3S9,3.34 9,5v6c0,1.66 1.34,3 3,3zM17,11c0,2.76 -2.24,5 -5,5s-5,-2.24 -5,-5L5,11c0,3.53 2.61,6.43 6,6.92L11,21h4v-3.08c3.39,-0.49 6,-3.39 6,-6.92h-4z" />
    </group>
</vector>
