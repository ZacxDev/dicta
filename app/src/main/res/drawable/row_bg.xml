<?xml version="1.0" encoding="utf-8"?>
<!--
  A grouped row on the setup screen: elevation level 1 of the surface ramp
  against the level-0 window, with a decorative hairline. Used to turn
  MainActivity's flat list of labels into addressable panels without a
  component library.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/dicta_surface_1" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="@color/dicta_divider" />
</shape>
