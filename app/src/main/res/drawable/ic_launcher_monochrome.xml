<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon MONOCHROME layer (Android 13+ themed icons).

  The system discards this layer's colour entirely and re-tints it from the
  user's wallpaper palette, so the fill here is a placeholder white and NOT a
  design decision — do not "fix" it to the accent colour, which would read as
  though it controlled anything.

  Same glyph and same <group> transform as ic_launcher_foreground.xml so the
  themed and full-colour icons are registered identically; only the fill
  differs. Themed icons are masked by the same shapes, so the 66dp safe-circle
  arithmetic in the foreground applies here unchanged.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

