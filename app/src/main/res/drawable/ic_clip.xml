<?xml version="1.0" encoding="utf-8"?>
<!--
  The shared-clipboard button's glyph: two overlapping screens, for "the same
  clipboard on two devices".

  🔴 NOT A CLIPBOARD, and @drawable/ic_snip's own header records why that
  matters here specifically. A clipboard glyph was tried on the snip button and
  removed for being near-indistinguishable from @drawable/ic_copy, which is an
  actual clipboard write — so the app already carried two clipboard glyphs
  meaning different things once, and adding a THIRD is the same mistake with one
  more instance. What distinguishes this control from both is not the clipboard,
  it is the SECOND DEVICE.

  🔴 Also not a cloud, not arrows, and not a "sync" circular pair. A cloud is
  wrong on the facts: this store is mesh-only with no public ingress (settled
  decision 2), and a cloud is exactly the thing the operator chose against.
  Arrows read as "upload", which is the half the deferred outbox makes
  invisible.

  STROKED, like @drawable/ic_snip and unlike the Material fill paths: two
  nested rectangles are strokes by nature, and outlining them to a fill would
  add points to say the same thing. `imageTintList` at the call site
  (BubbleService.buildWindow) tints a stroke exactly as it tints a fill.

  strokeWidth 2.0, not ic_snip's 2.2. Judged at the size it is DRAWN — 24dp
  inside the 44dp CLIP_DP button, i.e. 72px on the 3x target handset — because
  that is the rule ic_snip's header sets down after measuring. Two rectangles
  have four corners each where a brace has none, and at 2.2 the near corners of
  the overlapping pair close up into a blob; 2.0 keeps the gap between them
  open. This is a judgement about THIS glyph at THAT size, which is why it is
  not derived from ic_snip's number.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The far device: open on three sides, so the near one reads as in front
         of it rather than as a second complete box beside it. -->
    <path
        android:pathData="M8.2,8.2L8.2,4.6C8.2,4.0 8.7,3.5 9.3,3.5L19.4,3.5C20.0,3.5 20.5,4.0 20.5,4.6L20.5,13.6C20.5,14.2 20.0,14.7 19.4,14.7L15.8,14.7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- The near device, closed. -->
    <path
        android:pathData="M4.6,9.3L14.7,9.3C15.3,9.3 15.8,9.8 15.8,10.4L15.8,19.4C15.8,20.0 15.3,20.5 14.7,20.5L4.6,20.5C4.0,20.5 3.5,20.0 3.5,19.4L3.5,10.4C3.5,9.8 4.0,9.3 4.6,9.3Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
