<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon BACKGROUND layer. 108x108dp is mandatory for both layers.

  This layer must be fully opaque edge to edge and carry no meaning: the
  launcher masks it to a circle/squircle/teardrop of its choosing and
  parallaxes it independently of the foreground, so anything recognisable
  out here gets cropped or slides out of view.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Opaque base. Diagonal so the squircle mask doesn't read as flat. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="@color/ic_launcher_bg_start" />
                <item android:offset="1" android:color="@color/ic_launcher_bg_end" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Centred cyan glow, so the mic sits in light rather than on a slab.
         Radius 44 keeps the visible falloff inside the 72dp guaranteed-visible
         window; it may be clipped by an aggressive mask without losing anything. -->
    <path android:pathData="M54,54m-44,0a44,44 0,1 1,88 0a44,44 0,1 1,-88 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="44">
                <item android:offset="0" android:color="@color/ic_launcher_glow_inner" />
                <item android:offset="1" android:color="@color/ic_launcher_glow_outer" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
