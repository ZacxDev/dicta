<?xml version="1.0" encoding="utf-8"?>
<!--
  The overflow ("More actions") trigger, which sits next to the mic at rest and
  is therefore part of the minimal resting state.

  It is deliberately quieter than icon_button_bg: transparent at rest with a 1dp
  @color/dicta_outline ring, so it is unmistakably a tappable control (the ring
  clears 3:1 on surface_2) without competing with the accent-filled mic pill
  for attention. Pressed and checked both fill with the accent container.

  state_selected is the "actions are currently revealed" state — the control is
  a toggle, and the selected fill is backed by a contentDescription/tooltipText
  swap in DictateActivity so the state is not colour-only.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/dicta_accent_container" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/dicta_accent_container" />
            <stroke android:width="1dp" android:color="@color/dicta_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/dicta_outline" />
        </shape>
    </item>
</selector>
