<?xml version="1.0" encoding="utf-8"?>
<!--
  The transcript field — the one hero element of the minimal overlay.
  Elevation level 3 of the surface ramp.

  The boundary is @color/dicta_outline (3.51:1 on surface_2, 3.11:1 on
  surface_3), not the decorative divider: the fill step from level 2 to level 3
  is only ~1.33:1, so without this stroke the field's edge would be below
  WCAG 1.4.11's 3:1 for a UI-component boundary and a user could not see where
  the editable region starts.

  The focused state swaps the stroke to the accent at 2dp. That is additive to
  the platform's own cursor and selection handles (which Theme.Dicta.Overlay
  points at the accent too), so focus is never signalled by colour alone.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dicta_surface_3" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/dicta_accent" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dicta_surface_3" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/dicta_outline" />
        </shape>
    </item>
</selector>
