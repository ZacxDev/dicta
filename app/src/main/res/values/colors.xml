<?xml version="1.0" encoding="utf-8"?>
<!--
  Dicta's palette. DARK ONLY — there is deliberately no values-night/ and no
  light variant, so every token below is a final value rather than one half of
  a pair. If a light theme is ever wanted, that is a new file, not an edit here.

  ## The system, in three parts

  1. A SURFACE RAMP (`dicta_surface_0` .. `dicta_surface_4`). Five steps of one
     cool near-neutral (hue ~225, saturation under 15%). Elevation in Dicta is
     expressed by *which step of this ramp a surface uses*, not by a shadow:
     the dictation card is a floating dialog, so a drop shadow is drawn (and
     clipped) by the window, not by the content. The documented mapping is

        level 0  surface_0  #0A0B0F   the app window                 (MainActivity)
        level 1  surface_1  #12141A   a grouped row / inert panel
        level 2  surface_2  #1A1D25   the floating dictation card    (card_bg)
        level 3  surface_3  #232732   an input field, a pressed icon (input_bg)
        level 4  surface_4  #2E3340   a hairline fill, a disabled control

     Each step is ~1.3:1 against its neighbour, which is a visible lift without
     being a stripe. That is intentionally NOT enough contrast to carry meaning
     on its own — anything that must be *perceived* as a boundary uses
     `dicta_outline`, which is ≥3:1 against both surface_2 and surface_3.

  2. ON-COLOURS, measured rather than asserted. Ratios are WCAG 2.1 relative
     luminance, computed against the surfaces each token is actually used on
     (not against pure black, which flatters everything):

        dicta_on_surface          #E8EAF0   16.35 / 15.31 / 14.01 / 12.40 : 1  on surface_0..3
        dicta_on_surface_variant  #AEB5C7    9.59 /  8.97 /  8.21 /  7.27 : 1  on surface_0..3
        dicta_accent              #FFA070    9.85 /  9.22 /  8.44 /  7.47 : 1  on surface_0..3
        dicta_on_accent           #2A1206    8.85 : 1 on dicta_accent
        dicta_on_accent_container #FFD3BC    9.84 : 1 on dicta_accent_container
        dicta_error               #FF7B72    6.68 : 1 on surface_2
        dicta_live                #FF5C7A    5.67 : 1 on surface_2
        dicta_outline             #6A7288    3.51 : 1 on surface_2, 3.11 : 1 on surface_3

     Body text therefore clears AA (4.5:1) everywhere, icons and large text
     clear 3:1 everywhere, and the one token used as a *control boundary*
     clears 1.4.11's 3:1 on both surfaces it is drawn over.

  3. ONE SIGNATURE ACCENT, `dicta_accent` = #FFA070 ("ember"). Warm, against a
     cool neutral ramp — that opposition is the identity, and it is a deliberate
     break from the previous #4DD0E1 cyan-on-grey, which was the stock dark
     Material look. The accent is reserved for the dictation affordance itself:
     the mic control, a focused field, the launcher glyph, the bubble ring.

  ## State is never carried by colour alone

  `dicta_live` and `dicta_error` exist so that *recording* and *failed* have
  their own hue, but every place they are used also changes text (the mic
  control's label becomes "Stop", `status_text` names the state). A colour-only
  signal would fail 1.4.1.

  ## Legacy names

  The `dicta_bg` / `dicta_card` / `dicta_input` / `dicta_text` / `dicta_text_dim`
  / `dicta_bubble` tokens below are KEPT as aliases rather than renamed away.
  They are referenced from layouts that other in-flight branches are editing at
  the same time; deleting them would turn a mechanical merge into a hunt for
  every reference. New work should use the ramp tokens.
-->
<resources>

    <!-- ===== surface ramp (elevation levels 0..4) ===== -->
    <color name="dicta_surface_0">#0A0B0F</color>
    <color name="dicta_surface_1">#12141A</color>
    <color name="dicta_surface_2">#1A1D25</color>
    <color name="dicta_surface_3">#232732</color>
    <color name="dicta_surface_4">#2E3340</color>

    <!-- ===== on-colours ===== -->
    <color name="dicta_on_surface">#E8EAF0</color>
    <color name="dicta_on_surface_variant">#AEB5C7</color>

    <!-- Control BOUNDARY. ≥3:1 on surface_2 and surface_3, so it can be the
         only thing telling the user where a text field ends. -->
    <color name="dicta_outline">#6A7288</color>
    <!-- Decorative hairline / divider. Deliberately below 3:1: it must never be
         the only cue for anything. -->
    <color name="dicta_divider">#2E3340</color>

    <!-- ===== signature accent ===== -->
    <color name="dicta_accent">#FFA070</color>
    <color name="dicta_on_accent">#2A1206</color>
    <color name="dicta_accent_container">#4A2416</color>
    <color name="dicta_on_accent_container">#FFD3BC</color>

    <!-- ===== state ===== -->
    <color name="dicta_live">#FF5C7A</color>
    <color name="dicta_error">#FF7B72</color>

    <!-- ===== legacy aliases — see the header ===== -->
    <color name="dicta_bg">@color/dicta_surface_0</color>
    <color name="dicta_card">@color/dicta_surface_2</color>
    <color name="dicta_input">@color/dicta_surface_3</color>
    <color name="dicta_text">@color/dicta_on_surface</color>
    <color name="dicta_text_dim">@color/dicta_on_surface_variant</color>
    <color name="dicta_bubble">@color/dicta_surface_2</color>
</resources>
