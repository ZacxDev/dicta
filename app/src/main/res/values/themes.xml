<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The setup screen.

      The parent stays the PLATFORM dark Material theme. Dicta has no Material
      Components dependency (see app/build.gradle.kts), so the visual identity
      is carried by the colour tokens in colors.xml and by the shape drawables,
      not by a component library.

      colorAccent / colorControlActivated / textColorHighlight are set because
      this screen still uses platform widgets (Switch, Button, text selection
      handles) that otherwise render in the stock Material teal and would fight
      the ember accent.
    -->
    <style name="Theme.Dicta" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/dicta_surface_0</item>
        <item name="android:colorBackground">@color/dicta_surface_0</item>
        <item name="android:colorAccent">@color/dicta_accent</item>
        <item name="android:colorControlActivated">@color/dicta_accent</item>
        <item name="android:colorControlNormal">@color/dicta_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/dicta_on_surface</item>
        <item name="android:textColorSecondary">@color/dicta_on_surface_variant</item>
        <item name="android:textColorHighlight">@color/dicta_accent_container</item>
        <item name="android:statusBarColor">@color/dicta_surface_0</item>
        <item name="android:navigationBarColor">@color/dicta_surface_0</item>
    </style>

    <!-- Section heading on the setup screen: the one place the accent appears
         on an otherwise plain list. Accent on surface_0 measures 9.85:1, and
         13sp bold tracked-out is read as a label, not as body text. -->
    <!-- parent="" is REQUIRED, not noise: aapt2 treats a dotted style name as
         implicit inheritance, so without it this tries to extend a
         non-existent style/Text.Dicta and fails to link. -->
    <style name="Text.Dicta.SectionHeading" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/dicta_accent</item>
    </style>

    <!--
      Floating overlay: a centred card over whatever is underneath, which stays
      visible and dimmed.

      Measured facts behind each line (see DictateOverlayThemeTest):

      * windowIsFloating is already inherited as true from
        Theme.Material.Dialog — it resolves true even with the old theme, so
        "the window is not floating" was NOT the fullscreen cause. It is pinned
        explicitly so a future parent change cannot silently turn the activity
        back into a fullscreen window.

      * windowBackground must be a drawable that reports padding. A dialog's
        screen margin on Android is decor padding taken from this drawable
        (Drawable.getPadding -> View padding in setBackgroundDrawable), NOT a
        layout margin. The previous value — @android:color/transparent — is a
        ColorDrawable, which reports no padding, so the decor inset became zero
        and the card sat flush against the screen edges.
        @drawable/overlay_window_bg is an <inset> that restores it, by the same
        mechanism @android:drawable/dialog_background_material uses.

      * The width cap is NOT here. windowFixedWidthMinor/Major — the only theme
        attributes that can make a floating window narrower than its content
        wants — are private platform attributes and fail to link from an app
        theme ("style attribute 'android:attr/windowFixedWidthMinor' is
        private"). windowMinWidth* can only widen. So the cap is applied in code
        via Window.setLayout(), from @fraction/overlay_width_fraction. See
        DictateActivity.applyFloatingWindowSize().

      * windowAnimationStyle is deliberately NOT overridden: it already resolves
        to Animation.Material.Dialog through the parent (measured: 0x10302ff),
        i.e. a dialog fade rather than an activity-launch slide. The public
        alternatives are all downgrades, and @android:style/Animation.Material.Dialog
        is itself a private resource.

      🔴 The 2026-10 design pass (new palette + minimal overlay) changed ONLY
      the colour items below. `parent`, `windowBackground`, `windowIsFloating`,
      `windowIsTranslucent` and `backgroundDimAmount` were left byte-identical
      on purpose: switching the parent to a Material3 dialog theme, or pointing
      windowBackground at a plain colour or a <shape>, removes the <inset>'s
      reported padding and that padding IS the floating card's screen margin.
      Re-verified after the pass on an SM-G991W / Android 15: the window still
      resolves to (993xwrap) gr=CENTER on a 1080px display.
    -->
    <style name="Theme.Dicta.Overlay" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@drawable/overlay_window_bg</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:colorAccent">@color/dicta_accent</item>
        <item name="android:colorControlActivated">@color/dicta_accent</item>
        <item name="android:colorControlNormal">@color/dicta_on_surface_variant</item>
        <item name="android:textColorPrimary">@color/dicta_on_surface</item>
        <item name="android:textColorSecondary">@color/dicta_on_surface_variant</item>
        <item name="android:textColorHighlight">@color/dicta_accent_container</item>
    </style>
</resources>
