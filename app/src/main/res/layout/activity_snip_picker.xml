<?xml version="1.0" encoding="utf-8"?>
<!--
  The snippet picker: a search field over a scrolling list of snippets.

  🔴 A floating Activity rather than a view in the bubble's overlay window, for
  two independent reasons written out on SnipPickerActivity: a search field
  needs IME focus, which the bubble's FLAG_NOT_FOCUSABLE window cannot give it
  without stealing focus from the app underneath; and from Android 10 only the
  focused app may READ the clipboard, which {{clip}} resolution requires.

  Built from the same four conventions as activity_settings.xml and from no new
  ones: @drawable/input_bg on the field, @color/dicta_on_surface for text,
  @style/Text.Dicta.SectionHeading for the heading, and a framework ListView
  (NOT a RecyclerView — the app has zero runtime dependencies by decision; see
  app/build.gradle.kts).

  The list's height is match_parent inside a weighted slot rather than
  wrap_content: wrap_content asks a ListView to measure every row, which both
  defeats recycling and unbounds the window.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        style="@style/Text.Dicta.SectionHeading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/snip_title" />

    <EditText
        android:id="@+id/snip_search"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/input_bg"
        android:hint="@string/snip_search_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@color/dicta_on_surface"
        android:textColorHint="@color/dicta_on_surface_variant"
        android:textSize="15sp" />

    <!-- The one place a reason is shown when there are no rows. Three distinct
         reasons (nothing imported / an empty catalog / nothing matches) share
         this view and never share a string — see SnipPickerActivity.render. -->
    <TextView
        android:id="@+id/snip_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/snip_empty_no_catalog"
        android:textColor="@color/dicta_on_surface_variant"
        android:textSize="15sp"
        android:visibility="gone" />

    <ListView
        android:id="@+id/snip_list"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:overScrollMode="never"
        android:visibility="gone" />
</LinearLayout>
