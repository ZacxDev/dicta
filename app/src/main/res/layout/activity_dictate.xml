<?xml version="1.0" encoding="utf-8"?>
<!--
  The floating card. Wrapped in a ScrollView because the window is a floating
  dialog with WRAP_CONTENT height: on a landscape phone (~411dp of usable
  height, minus the 12dp window inset top and bottom) the column below is
  taller than the window can be, and without a scroll container the bottom
  action row would simply be clipped off the card.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:id="@+id/dictate_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dictate_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dicta_text" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/dictate_hint"
            android:textColor="@color/dicta_text_dim" />

        <!--
          The microphone level meter.

          🔴 Not decoration. In the remote-only degradation tiers no partial
          text ever appears while recording, so this bar is the ONLY on-screen
          evidence that the microphone is live. Without it "nothing is moving"
          is indistinguishable from a dead capture — and a dead capture is a
          real state here, because Android enforces its one-capture-at-a-time
          policy by silently feeding the loser exact zeros.
        -->
        <ProgressBar
            android:id="@+id/level_meter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:contentDescription="@string/stt_level"
            android:visibility="gone" />

        <!--
          Which engine produced the text currently in the box. The server and
          the phone disagree, sometimes materially, so the user has to be able
          to tell them apart rather than trust whatever appeared.
        -->
        <TextView
            android:id="@+id/engine_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="@color/dicta_text_dim"
            android:visibility="gone" />

        <EditText
            android:id="@+id/dictated_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="4"
            android:gravity="top"
            android:layout_marginTop="12dp"
            android:hint="@string/dictate_text_hint"
            android:textColor="@color/dicta_text"
            android:textColorHint="@color/dicta_text_dim"
            android:background="@drawable/input_bg"
            android:padding="12dp"
            android:inputType="textMultiLine|textCapSentences" />

        <!-- Shown only once a screenshot has actually been attached. The note is
             not decoration: many share targets drop EXTRA_TEXT when a stream is
             present, so the user needs to know Copy is the reliable text path. -->
        <TextView
            android:id="@+id/attachment_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="12sp"
            android:textColor="@color/dicta_text_dim"
            android:visibility="gone"
            android:text="@string/screenshot_attached_note" />

        <Button
            android:id="@+id/mic_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/start_dictation" />

        <!-- Icon-only actions: the labelled variants were truncated at this width
             (ALL-CAPS Material buttons can't fit inside the dialog card). Four
             52dp icon buttons at weight 1 still fit — there is no text to
             ellipsize, so the truncation bug cannot recur. Every one needs BOTH
             contentDescription (a11y) and tooltipText (discoverability), since
             there is no visible label. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <ImageButton
                android:id="@+id/copy_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:src="@drawable/ic_copy"
                android:scaleType="center"
                android:background="@drawable/icon_button_bg"
                android:tint="@color/dicta_text"
                android:contentDescription="@string/copy"
                android:tooltipText="@string/copy" />

            <ImageButton
                android:id="@+id/screenshot_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_screenshot"
                android:scaleType="center"
                android:background="@drawable/icon_button_bg"
                android:tint="@color/dicta_text"
                android:contentDescription="@string/screenshot"
                android:tooltipText="@string/screenshot" />

            <ImageButton
                android:id="@+id/share_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_send"
                android:scaleType="center"
                android:background="@drawable/icon_button_bg"
                android:tint="@color/dicta_text"
                android:contentDescription="@string/share"
                android:tooltipText="@string/share" />

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_close"
                android:scaleType="center"
                android:background="@drawable/icon_button_bg"
                android:tint="@color/dicta_text"
                android:contentDescription="@string/close"
                android:tooltipText="@string/close" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
