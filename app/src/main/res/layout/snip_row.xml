<?xml version="1.0" encoding="utf-8"?>
<!--
  One picker row: the label and its category on the first line, a truncated
  one-line body preview on the second.

  🔴 The body is NEVER rendered in full. Sized against a real catalog, bodies
  reach 747 characters and are multi-line, so a row showing the body would be a
  screenful per entry. The truncation itself is SnipRow.preview — a character
  budget, because this project's Robolectric cannot measure text and a rendered
  width claim could therefore be checked nowhere. ellipsize here is the
  backstop for whatever the device does with those characters.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_bg"
    android:layout_marginBottom="6dp"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/snip_row_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dicta_on_surface"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/snip_row_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/dicta_on_surface_variant"
        android:textSize="13sp" />
</LinearLayout>
