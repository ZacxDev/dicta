<?xml version="1.0" encoding="utf-8"?>
<!--
  The setup screen, restyled by the 2026-10 design pass to the surface ramp in
  colors.xml.

  Structural change: the flat run of TextViews became three addressable groups
  (a masthead, Permissions, Triggers), with the permission/trigger rows drawn as
  level-1 panels (@drawable/row_bg) over the level-0 window. Nothing moved
  logically — every id MainActivity addresses is unchanged and in the same
  order: @id/mic_status, @id/grant_mic_button, @id/overlay_status,
  @id/grant_overlay_button, @id/add_tile_button, @id/bubble_switch,
  @id/notif_switch, @id/try_now_button.

  🔴 RESERVED SLOT: @id/settings_slot, below Triggers and above "Try dictation
  now". In-flight work on another branch adds a settings screen (API token +
  base URL) reachable from here. It is an empty, GONE FrameLayout and NOT a dead
  control on purpose — a visible button that opens nothing is worse than no
  button. To use it: drop the entry row in as its child, flip visibility to
  visible, and label it @string/settings (already defined). Placement is
  deliberate: settings is configuration, so it belongs after the things it
  configures and before the call to action.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dicta_surface_0"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Masthead. The accent mic glyph is the only place the icon's artwork
             appears in-app, which is what ties the launcher icon to the app. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:src="@drawable/ic_mic"
                android:tint="@color/dicta_accent"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textSize="30sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01"
                android:textColor="@color/dicta_on_surface" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/intro"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/dicta_on_surface_variant" />

        <!-- ===== Permissions ===== -->
        <TextView
            style="@style/Text.Dicta.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/section_permissions" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:background="@drawable/row_bg"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/mic_row"
                    android:textSize="15sp"
                    android:textColor="@color/dicta_on_surface" />

                <TextView
                    android:id="@+id/mic_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/status_not_granted"
                    android:textSize="13sp"
                    android:textColor="@color/dicta_on_surface_variant" />
            </LinearLayout>

            <Button
                android:id="@+id/grant_mic_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:minWidth="88dp"
                android:background="@drawable/outline_button_bg"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/dicta_on_surface"
                android:text="@string/grant" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/row_bg"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/overlay_row"
                    android:textSize="15sp"
                    android:textColor="@color/dicta_on_surface" />

                <TextView
                    android:id="@+id/overlay_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/status_not_granted"
                    android:textSize="13sp"
                    android:textColor="@color/dicta_on_surface_variant" />
            </LinearLayout>

            <Button
                android:id="@+id/grant_overlay_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:minWidth="88dp"
                android:background="@drawable/outline_button_bg"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/dicta_on_surface"
                android:text="@string/grant" />
        </LinearLayout>

        <!-- ===== Triggers ===== -->
        <TextView
            style="@style/Text.Dicta.SectionHeading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/section_triggers" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:background="@drawable/row_bg"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tile_row"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/dicta_on_surface" />

            <Button
                android:id="@+id/add_tile_button"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:minWidth="110dp"
                android:background="@drawable/outline_button_bg"
                android:stateListAnimator="@null"
                android:textAllCaps="false"
                android:textColor="@color/dicta_on_surface"
                android:text="@string/add_tile" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/row_bg"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/bubble_row"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/dicta_on_surface" />

            <Switch
                android:id="@+id/bubble_switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:background="@drawable/row_bg"
            android:padding="14dp"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/notif_row"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/dicta_on_surface" />

            <Switch
                android:id="@+id/notif_switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- 🔴 RESERVED — see the file header. Empty and GONE; it is a slot, not
             a control. Do not give it a listener here. -->
        <FrameLayout
            android:id="@+id/settings_slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <!-- The only accent-filled control on this screen, matching the mic
             pill in the overlay: the accent always means "dictate". -->
        <Button
            android:id="@+id/try_now_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/mic_pill_bg"
            android:drawableStart="@drawable/ic_mic"
            android:drawableTint="@color/dicta_on_accent"
            android:drawablePadding="8dp"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/dicta_on_accent"
            android:text="@string/try_now" />
    </LinearLayout>
</ScrollView>
